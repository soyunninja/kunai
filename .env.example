# Private Nuxt server runtime configuration.
# Copy to `.env` for local development. Do not commit real secrets.

# Required: PocketBase endpoint reachable by the Nuxt server.
NUXT_POCKETBASE_URL=http://127.0.0.1:8090

# Required: externally visible Nuxt application origin.
NUXT_APP_ORIGIN=http://localhost:3000

# Optional: defaults to `secure` when omitted.
# Use `development-http` only for local HTTP development/tests.
# Production HTTPS should use `secure` or omit this variable.
NUXT_SESSION_COOKIE_MODE=development-http